DATABASE_URL="postgresql://cril:cril@localhost:5432/cril?schema=public"
API_PORT=4000
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
WEB_ORIGIN="http://localhost:3000"
API_PUBLIC_URL="http://localhost:4000"
WEB_PUBLIC_URL="http://localhost:3000"
JWT_SECRET="replace-with-a-random-secret-of-at-least-32-characters"
JWT_ISSUER="eiasc-cril"
BOOTSTRAP_ADMIN_EMAIL="admin@example.test"
BOOTSTRAP_ADMIN_PASSWORD="use-a-long-development-password"
RESET_TOKEN_DEBUG="false"
# Production email delivery. Keep both values in the deployment secret store/environment, never in Git.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="EIASC CRil <no-reply@your-verified-domain.example>"
# Registration fee fallbacks. Super Admin can override these in Platform Settings.
REGISTRATION_INDIVIDUAL_FEE_ETB=100
REGISTRATION_INSTITUTION_FEE_ETB=500
# Legacy single receiving-account fallbacks. Prefer the Super Admin bank-account list for bank transfers.
REGISTRATION_TELEBIRR_NAME="EIASC"
REGISTRATION_TELEBIRR_NUMBER=""
# Telebirr server-side credentials. Never expose these to the browser or store them in the database.
TELEBIRR_ENVIRONMENT="SANDBOX"
TELEBIRR_FABRIC_APP_ID=""
TELEBIRR_APP_SECRET=""
TELEBIRR_MERCHANT_APP_ID=""
TELEBIRR_MERCHANT_CODE=""
TELEBIRR_PRIVATE_KEY=""
TELEBIRR_PUBLIC_KEY=""
TELEBIRR_NOTIFY_URL=""
TELEBIRR_REDIRECT_URL=""
# Chapa server-side integration. Never expose the secret key to the browser.
CHAPA_SECRET_KEY=""
# Pinned geography source used by db:bootstrap. Override only when deliberately updating the approved dataset.
GEOGRAPHY_SOURCE_VERSION="418739e33760bf79661f3914e2d8c9cf33248437"
GEOGRAPHY_SOURCE_URL="https://raw.githubusercontent.com/Jafermenza/ethiopia-administrative-divisions/418739e33760bf79661f3914e2d8c9cf33248437/data/hierarchy.json"
