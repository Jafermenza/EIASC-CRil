generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum RoleCode {
  SUPER_ADMIN
  NATIONAL_ADMIN
  REGIONAL_ADMIN
  ZONE_ADMIN
  DISTRICT_ADMIN
  REGISTRAR
  INSPECTOR
  FINANCE_OFFICER
  INSTITUTION_ADMIN
  MEMBER
}

enum JurisdictionLevel {
  NATIONAL
  REGION
  ZONE_CITY
  SUBCITY_TOWN
  DISTRICT
  INSTITUTION
}

enum InstitutionStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
  CLOSED
}

enum MemberStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REVOKED
}

enum RegistrationType {
  INDIVIDUAL
  INSTITUTION
}

enum RegistrationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CORRECTION
  RESUBMITTED
  APPROVED
  REJECTED
  REVOKED
}

enum InstitutionApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  RESUBMITTED
  APPROVED
  REJECTED
}

enum InstitutionRelationshipType {
  PRIMARY
  SECONDARY
  OTHER
}

enum InstitutionRelationshipStatus {
  ACTIVE
  INACTIVE
}

enum GeographyImportStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum LicenseStatus {
  PENDING
  ACTIVE
  EXPIRED
  SUSPENDED
  REVOKED
}

enum LicenseApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  RESUBMITTED
  APPROVED
  REJECTED
}

enum InspectionStatus {\n  ASSIGNED\n  IN_PROGRESS\n  COMPLETED\n  CANCELLED\n}\n\nenum InspectionDecision {\n  PENDING\n  PASS\n  FAIL\n  CONDITIONAL\n}\n\nmodel Registration {
  MEMBER
  INSTITUTION
  LICENSE
}

enum CredentialStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum MembershipStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ENDED
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  PUSH
  USSD
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum AllocationPolicyStatus {
  DRAFT
  APPROVED
  RETIRED
}

enum AllocationRunStatus {
  PREVIEW
  UNDER_REVIEW
  APPROVED
  FINALIZED
  CANCELLED
}

model User {
  id                  String            @id @default(uuid()) @db.Uuid
  email               String?           @unique
  phone               String?           @unique
  passwordHash        String
  status              UserStatus        @default(ACTIVE)
  jurisdictionLevel   JurisdictionLevel @default(NATIONAL)
  jurisdictionId      String?
  institutionId       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  roles               UserRole[]
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  geographyImports    GeographyImport[]
  notifications       Notification[]\n  reviewSnapshots      ApplicationReviewSnapshot[]\n  correctionRequests   ApplicationCorrection[]\n  assignedInspections  Inspection[]
  createdPolicies     AllocationPolicy[] @relation("PolicyCreatedBy")
  approvedPolicies    AllocationPolicy[] @relation("PolicyApprovedBy")
  calculatedRuns      AllocationRun[]    @relation("RunCalculatedBy")
  approvedRuns        AllocationRun[]    @relation("RunApprovedBy")
  @@index([jurisdictionLevel, jurisdictionId])
  @@index([institutionId])
}

model Role {
  id        String     @id @default(uuid()) @db.Uuid
  code      RoleCode   @unique
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     UserRole[]
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@unique([userId, roleId])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model PasswordResetToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, usedAt])
  @@index([expiresAt])
}

model GeographyImport {
  id                String                @id @default(uuid()) @db.Uuid
  source            String
  sourceVersion     String
  sourceUrl         String
  status            GeographyImportStatus @default(RUNNING)
  startedAt         DateTime              @default(now())
  completedAt       DateTime?
  importedByUserId  String?               @db.Uuid
  regionCount       Int                   @default(0)
  zoneCount         Int                   @default(0)
  districtCount     Int                   @default(0)
  createdCount      Int                   @default(0)
  updatedCount      Int                   @default(0)
  deactivatedCount Int                   @default(0)
  errorCount       Int                   @default(0)
  errors             Json?
  importedBy        User?                 @relation(fields: [importedByUserId], references: [id], onDelete: SetNull)
  @@index([source, sourceVersion])
  @@index([status, startedAt])
}

model Region {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique
  name         String
  latitude     Float?
  longitude    Float?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  zones        ZoneCity[]
  institutions Institution[] @relation("RegionInstitutions")
  members      Member[]      @relation("RegionMembers")
  applications InstitutionApplication[] @relation("RegionApplications")
  @@index([name])
}

model ZoneCity {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique
  name         String
  latitude     Float?
  longitude    Float?
  regionId     String        @db.Uuid
  region       Region        @relation(fields: [regionId], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subcities    SubcityTown[]
  districts    District[]    @relation("ZoneDistricts")
  institutions Institution[] @relation("ZoneInstitutions")
  members      Member[]      @relation("ZoneMembers")
  applications InstitutionApplication[] @relation("ZoneApplications")
  @@index([regionId])
}

model SubcityTown {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique
  name         String
  latitude     Float?
  longitude    Float?
  zoneId       String        @db.Uuid
  zone         ZoneCity      @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  districts    District[]
  institutions Institution[] @relation("SubcityInstitutions")
  members      Member[]      @relation("SubcityMembers")
  applications InstitutionApplication[] @relation("SubcityApplications")
  @@index([zoneId])
}

model District {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique
  name         String
  latitude     Float?
  longitude    Float?
  zoneId       String?       @db.Uuid
  subcityId    String?       @db.Uuid
  zone         ZoneCity?     @relation("ZoneDistricts", fields: [zoneId], references: [id], onDelete: Restrict)
  subcity      SubcityTown?  @relation(fields: [subcityId], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  institutions Institution[] @relation("DistrictInstitutions")
  members      Member[]      @relation("DistrictMembers")
  applications InstitutionApplication[] @relation("DistrictApplications")
  @@index([subcityId])
  @@index([zoneId])
}

model InstitutionType {
  id            String        @id @default(uuid()) @db.Uuid
  code          String        @unique
  name          String        @unique
  description   String?
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  institutions  Institution[]
  applications  InstitutionApplication[]
}

model Institution {
  id                  String             @id @default(uuid()) @db.Uuid
  institutionCode     String?            @unique
  name                String
  alternativeName     String?
  institutionTypeId   String             @db.Uuid
  establishmentDate   DateTime?
  phone               String?
  secondaryPhone      String?
  email               String?
  website             String?
  address             String?
  mission             String?
  description         String?
  services            String?
  communityActivities String?
  regionId            String             @db.Uuid
  zoneId              String             @db.Uuid
  subcityId           String?            @db.Uuid
  districtId          String             @db.Uuid
  latitude            Float?
  longitude           Float?
  locationVerified    Boolean            @default(false)
  status              InstitutionStatus  @default(PENDING)
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  type                InstitutionType    @relation(fields: [institutionTypeId], references: [id], onDelete: Restrict)
  region              Region             @relation("RegionInstitutions", fields: [regionId], references: [id], onDelete: Restrict)
  zone                ZoneCity           @relation("ZoneInstitutions", fields: [zoneId], references: [id], onDelete: Restrict)
  subcity             SubcityTown?       @relation("SubcityInstitutions", fields: [subcityId], references: [id], onDelete: Restrict)
  district            District           @relation("DistrictInstitutions", fields: [districtId], references: [id], onDelete: Restrict)
  registrations       Registration[]     @relation("InstitutionRegistration")
  applications        InstitutionApplication[]
  memberLinks         MemberInstitution[]
  leaders             InstitutionLeader[]
  staffSummary        InstitutionStaffSummary?
  education           InstitutionEducation?
  documents           InstitutionDocument[]\n  reviewSnapshots     ApplicationReviewSnapshot[]\n  correctionRequests  ApplicationCorrection[]\n  inspections         Inspection[]
  statusHistory       InstitutionStatusHistory[]
  licenses            License[]
  credentials         Credential[]
  allocationResults   ResourceAllocation[]
  @@index([regionId, zoneId, subcityId, districtId])
  @@index([status])
  @@index([name])
}

model InstitutionApplication {
  id                  String                     @id @default(uuid()) @db.Uuid
  trackingCode        String                     @unique
  status              InstitutionApplicationStatus @default(DRAFT)
  institutionName     String
  alternativeName     String?
  institutionTypeId   String                     @db.Uuid
  establishmentDate   DateTime
  phone               String
  email               String
  secondaryPhone      String?
  website             String?
  regionId            String                     @db.Uuid
  zoneId              String                     @db.Uuid
  subcityId           String?                    @db.Uuid
  districtId          String                     @db.Uuid
  address             String
  mission             String?
  description         String?
  services            String?
  communityActivities String?
  latitude            Float?
  longitude           Float?
  locationVerified    Boolean                    @default(false)
  applicantName       String?
  applicantPhone      String?
  applicantEmail      String?
  correctionReason    String?
  rejectionReason     String?
  institutionId       String?                    @db.Uuid
  submittedAt         DateTime?
  decisionAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  institutionType     InstitutionType            @relation(fields: [institutionTypeId], references: [id], onDelete: Restrict)
  region              Region                     @relation("RegionApplications", fields: [regionId], references: [id], onDelete: Restrict)
  zone                ZoneCity                   @relation("ZoneApplications", fields: [zoneId], references: [id], onDelete: Restrict)
  subcity             SubcityTown?               @relation("SubcityApplications", fields: [subcityId], references: [id], onDelete: Restrict)
  district            District                   @relation("DistrictApplications", fields: [districtId], references: [id], onDelete: Restrict)
  institution         Institution?               @relation(fields: [institutionId], references: [id], onDelete: SetNull)
  leaders             InstitutionApplicationLeader[]
  staffSummary        InstitutionApplicationStaffSummary?
  education           InstitutionApplicationEducation?
  documents           InstitutionDocument[]
  history             InstitutionStatusHistory[]
  @@index([status])
  @@index([regionId, zoneId, subcityId, districtId])
  @@index([institutionName])
}

model ApplicationReviewSnapshot {\n  id                         String                  @id @default(uuid()) @db.Uuid\n  registrationId             String?                 @db.Uuid\n  institutionApplicationId  String?                 @db.Uuid\n  capturedByUserId           String                  @db.Uuid\n  status                     String\n  snapshot                   Json\n  createdAt                  DateTime                @default(now())\n  registration               Registration?           @relation(fields: [registrationId], references: [id], onDelete: Cascade)\n  institutionApplication    InstitutionApplication? @relation(fields: [institutionApplicationId], references: [id], onDelete: Cascade)\n  capturedBy                 User                    @relation(fields: [capturedByUserId], references: [id], onDelete: Restrict)\n  @@index([registrationId, createdAt])\n  @@index([institutionApplicationId, createdAt])\n}\n\nmodel ApplicationCorrection {\n  id                         String                  @id @default(uuid()) @db.Uuid\n  registrationId             String?                 @db.Uuid\n  institutionApplicationId  String?                 @db.Uuid\n  requestedByUserId          String                  @db.Uuid\n  reason                     String\n  fields                     Json?\n  resolvedAt                 DateTime?\n  createdAt                  DateTime                @default(now())\n  registration               Registration?           @relation(fields: [registrationId], references: [id], onDelete: Cascade)\n  institutionApplication    InstitutionApplication? @relation(fields: [institutionApplicationId], references: [id], onDelete: Cascade)\n  requestedBy                User                    @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)\n  @@index([registrationId, createdAt])\n  @@index([institutionApplicationId, createdAt])\n}\n\nmodel Inspection {\n  id                         String             @id @default(uuid()) @db.Uuid\n  registrationId             String?            @db.Uuid\n  institutionApplicationId  String?            @db.Uuid\n  assignedToUserId           String             @db.Uuid\n  status                     InspectionStatus   @default(ASSIGNED)\n  decision                   InspectionDecision @default(PENDING)\n  scheduledAt                DateTime?\n  startedAt                  DateTime?\n  completedAt                DateTime?\n  findings                   Json?\n  decisionReason             String?\n  createdAt                  DateTime           @default(now())\n  updatedAt                  DateTime           @updatedAt\n  registration              Registration?      @relation(fields: [registrationId], references: [id], onDelete: Cascade)\n  institutionApplication    InstitutionApplication? @relation(fields: [institutionApplicationId], references: [id], onDelete: Cascade)\n  assignedTo                User               @relation(fields: [assignedToUserId], references: [id], onDelete: Restrict)\n  @@index([registrationId, status])\n  @@index([institutionApplicationId, status])\n  @@index([assignedToUserId, status])\n}\n\nmodel InstitutionApplicationLeader {
  id            String                  @id @default(uuid()) @db.Uuid
  applicationId String                  @db.Uuid
  fullName      String
  role          String
  phone         String
  email         String?
  application   InstitutionApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([applicationId])
}

model InstitutionLeader {
  id            String       @id @default(uuid()) @db.Uuid
  institutionId String       @db.Uuid
  fullName      String
  role          String
  phone         String
  email         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  institution   Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  @@index([institutionId])
}

model InstitutionApplicationStaffSummary {
  id                         String                  @id @default(uuid())
  applicationId              String                  @unique @db.Uuid
  imamCount                  Int                     @default(0)
  teacherCount               Int                     @default(0)
  administrativeStaffCount   Int                     @default(0)
  otherStaffCount            Int                     @default(0)
  application                InstitutionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model InstitutionStaffSummary {
  id                         String       @id @default(uuid()) @db.Uuid
  institutionId              String       @unique @db.Uuid
  imamCount                  Int          @default(0)
  teacherCount               Int          @default(0)
  administrativeStaffCount   Int          @default(0)
  otherStaffCount             Int          @default(0)
  institution                Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model InstitutionApplicationEducation {
  id              String                  @id @default(uuid()) @db.Uuid
  applicationId   String                  @unique @db.Uuid
  studentCount    Int                     @default(0)
  teacherCount    Int                     @default(0)
  educationLevels String[]
  application     InstitutionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model InstitutionEducation {
  id              String       @id @default(uuid()) @db.Uuid
  institutionId   String       @unique @db.Uuid
  studentCount    Int          @default(0)
  teacherCount    Int          @default(0)
  educationLevels String[]
  institution     Institution  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
}

model InstitutionDocument {
  id                  String                  @id @default(uuid()) @db.Uuid
  institutionApplicationId String?            @db.Uuid
  institutionId       String?                 @db.Uuid
  documentType        String
  fileName             String
  storageKey           String                  @unique
  storageUrl            String
  mimeType             String
  size                 Int
  uploadedBy           String?                 @db.Uuid
  createdAt            DateTime                @default(now())
  application          InstitutionApplication? @relation(fields: [institutionApplicationId], references: [id], onDelete: Cascade)
  institution          Institution?           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  @@index([institutionApplicationId])
  @@index([institutionId])
}

model RegistrationDocument {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @db.Uuid
  memberId       String?      @db.Uuid
  documentType   String
  fileName       String
  storageKey     String       @unique
  storageUrl     String
  mimeType       String
  size           Int
  uploadedBy     String?      @db.Uuid
  createdAt      DateTime     @default(now())
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  member         Member?      @relation(fields: [memberId], references: [id], onDelete: SetNull)
  @@index([registrationId, createdAt])
  @@index([memberId, createdAt])
}

model InstitutionStatusHistory {
  id                  String                  @id @default(uuid()) @db.Uuid
  institutionId       String?                 @db.Uuid
  applicationId       String?                 @db.Uuid
  fromStatus          String?
  toStatus            String
  reason              String?
  actorUserId         String?                 @db.Uuid
  createdAt            DateTime                @default(now())
  institution          Institution?            @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  application          InstitutionApplication? @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  @@index([institutionId, createdAt])
  @@index([applicationId, createdAt])
}

model Member {
  id                 String              @id @default(uuid()) @db.Uuid
  membershipNumber   String?             @unique
  firstName          String
  middleName         String?
  lastName           String
  birthDate          DateTime
  gender              String
  maritalStatus      String
  phone              String              @unique
  email              String?             @unique
  educationLevel     String?
  fieldOfStudy       String?
  employmentStatus   String?
  careerRole         String?
  nationalIdentity   String?             @unique
  currentAddress     String?
  regionId           String              @db.Uuid
  zoneId             String              @db.Uuid
  subcityId          String?             @db.Uuid
  districtId         String              @db.Uuid
  status             MemberStatus        @default(PENDING)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  region             Region              @relation("RegionMembers", fields: [regionId], references: [id], onDelete: Restrict)
  zone               ZoneCity            @relation("ZoneMembers", fields: [zoneId], references: [id], onDelete: Restrict)
  subcity            SubcityTown?        @relation("SubcityMembers", fields: [subcityId], references: [id], onDelete: Restrict)
  district            District            @relation("DistrictMembers", fields: [districtId], references: [id], onDelete: Restrict)
  institutions       MemberInstitution[]
  registration       Registration?       @relation("MemberRegistration")
  registrationDocuments RegistrationDocument[]
  credentials        Credential[]
  @@index([phone])
  @@index([regionId, zoneId, subcityId, districtId])
}

model MemberInstitution {
  id               String                       @id @default(uuid()) @db.Uuid
  memberId         String                       @db.Uuid
  institutionId    String                       @db.Uuid
  relationshipType InstitutionRelationshipType @default(PRIMARY)
  status            MembershipStatus             @default(PENDING)
  startedAt         DateTime                    @default(now())
  endedAt           DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  member            Member                      @relation(fields: [memberId], references: [id], onDelete: Cascade)
  institution       Institution                 @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  @@unique([memberId, institutionId])
  @@index([institutionId, status])
  @@index([memberId, status])
}

model Registration {
  id                  String              @id @default(uuid()) @db.Uuid
  trackingCode        String              @unique
  type                RegistrationType
  status              RegistrationStatus  @default(DRAFT)
  declarationAccepted Boolean
  firstName           String?
  middleName          String?
  lastName            String?
  birthDate           DateTime?
  gender              String?
  maritalStatus       String?
  phone               String?
  email               String?
  educationLevel      String?
  fieldOfStudy        String?
  employmentStatus    String?
  careerRole          String?
  regionId            String?             @db.Uuid
  zoneId              String?             @db.Uuid
  subcityId           String?             @db.Uuid
  districtId          String?             @db.Uuid
  currentAddress      String?
  nationalIdentity    String?
  institutionId       String?             @db.Uuid
  familyRelationship  String?
  familyMemberName    String?
  familyMemberPhone   String?
  correctionReason    String?
  rejectionReason     String?
  decisionAt          DateTime?
  memberId            String?             @unique @db.Uuid
  documents            RegistrationDocument[]\n  reviewSnapshots      ApplicationReviewSnapshot[]\n  correctionRequests   ApplicationCorrection[]\n  inspections          Inspection[]
  submittedAt         DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  member              Member?             @relation("MemberRegistration", fields: [memberId], references: [id], onDelete: SetNull)
  institution         Institution?        @relation("InstitutionRegistration", fields: [institutionId], references: [id], onDelete: SetNull)
  @@index([status])
  @@index([type])
  @@index([phone])
  @@index([email])
  @@index([nationalIdentity])
}

model License {
  id                String                  @id @default(uuid()) @db.Uuid
  licenseNumber     String?                 @unique
  institutionId     String                  @db.Uuid
  licenseType       String
  status            LicenseStatus            @default(PENDING)
  applicationStatus LicenseApplicationStatus @default(DRAFT)
  issuedAt          DateTime?
  effectiveFrom     DateTime?
  expiresAt         DateTime?
  suspendedAt       DateTime?
  revokedAt         DateTime?
  reason            String?
  issuedBy          String?                 @db.Uuid
  approvedBy        String?                 @db.Uuid
  createdBy         String?                 @db.Uuid
  reviewedBy        String?                 @db.Uuid
  approvedAt        DateTime?
  reviewedAt        DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  institution       Institution             @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  credentials       Credential[]
  @@index([institutionId])
  @@index([status])
  @@index([expiresAt])
  @@index([applicationStatus])
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Uuid
  actorUserId String?   @db.Uuid
  action      String
  entityType  String
  entityId    String?
  requestId   String?
  metadata    Json?
  createdAt   DateTime  @default(now())
  actor       User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
}

model Credential {
  id             String         @id @default(uuid()) @db.Uuid
  credentialNumber String       @unique
  type           CredentialType
  status         CredentialStatus @default(ACTIVE)
  tokenHash      String         @unique
  memberId       String?        @db.Uuid
  institutionId  String?        @db.Uuid
  licenseId      String?        @db.Uuid
  issuedAt       DateTime       @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  member         Member?        @relation(fields: [memberId], references: [id], onDelete: Cascade)
  institution    Institution?   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  license        License?       @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  @@index([type, status])
  @@index([memberId])
  @@index([institutionId])
  @@index([licenseId])
}

model Notification {
  id          String              @id @default(uuid()) @db.Uuid
  recipientId String              @db.Uuid
  channel     NotificationChannel @default(IN_APP)
  type        String
  title       String
  message     String
  status      NotificationStatus  @default(PENDING)
  sentAt      DateTime?
  readAt      DateTime?
  metadata    Json?
  createdAt   DateTime            @default(now())
  recipient   User                @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  @@index([recipientId, status, createdAt])
}

model AllocationPolicy {
  id              String               @id @default(uuid()) @db.Uuid
  name            String
  version         String
  status          AllocationPolicyStatus @default(DRAFT)
  effectiveFrom   DateTime
  effectiveTo     DateTime?
  eligibilityRules Json
  formulaDefinition Json
  createdBy       String               @db.Uuid
  approvedBy      String?              @db.Uuid
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  creator         User                 @relation("PolicyCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)
  approver        User?                @relation("PolicyApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  runs            AllocationRun[]
  @@unique([name, version])
  @@index([status, effectiveFrom])
}

model AllocationRun {
  id                 String             @id @default(uuid()) @db.Uuid
  policyId           String             @db.Uuid
  policyVersion      String
  period             String
  fundingPool        Decimal          @db.Decimal(18, 2)
  eligibleMemberCount Int
  basePerMemberAmount Decimal         @db.Decimal(18, 2)
  equalizationPool   Decimal          @db.Decimal(18, 2)
  totalAllocated     Decimal          @db.Decimal(18, 2)
  status             AllocationRunStatus @default(PREVIEW)
  calculatedAt       DateTime           @default(now())
  approvedAt         DateTime?
  calculatedBy       String             @db.Uuid
  approvedBy         String?            @db.Uuid
  policy             AllocationPolicy   @relation(fields: [policyId], references: [id], onDelete: Restrict)
  calculator         User               @relation("RunCalculatedBy", fields: [calculatedBy], references: [id], onDelete: Restrict)
  approver           User?              @relation("RunApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)
  results            ResourceAllocation[]
  @@unique([policyId, period, calculatedAt])
  @@index([status, period])
}

model ResourceAllocation {
  id                  String        @id @default(uuid()) @db.Uuid
  allocationRunId     String        @db.Uuid
  institutionId       String        @db.Uuid
  eligibleMemberCount Int
  baseAmount          Decimal       @db.Decimal(18, 2)
  equalizationAmount   Decimal       @db.Decimal(18, 2)
  totalAmount         Decimal       @db.Decimal(18, 2)
  allocationRun        AllocationRun @relation(fields: [allocationRunId], references: [id], onDelete: Cascade)
  institution          Institution   @relation(fields: [institutionId], references: [id], onDelete: Restrict)
  @@unique([allocationRunId, institutionId])
  @@index([institutionId])
}
