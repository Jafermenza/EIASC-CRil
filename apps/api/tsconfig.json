{
  "compilerOptions": {
    "module": "commonjs", "declaration": true, "removeComments": true,
    "emitDecoratorMetadata": true, "experimentalDecorators": true, "target": "ES2021",
    "sourceMap": true, "outDir": "./dist", "baseUrl": "./", "strict": true,
    "moduleResolution": "node", "esModuleInterop": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "test/**/*.ts"]
}
