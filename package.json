{
  "name": "eiasc-cril",
  "private": true,
  "version": "0.1.0",
  "description": "EIASC Community Registration & Institutional Licensing Platform",
  "packageManager": "npm@10.9.8",
  "workspaces": ["apps/web", "apps/api", "packages/*"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace @eiasc/web\" \"npm run dev --workspace @eiasc/api\"",
    "build": "npm run build --workspace @eiasc/api && npm run build --workspace @eiasc/web",
    "lint": "eslint \"apps/**/*.ts\" \"apps/**/*.tsx\"",
    "typecheck": "npm run typecheck --workspace @eiasc/api && npm run typecheck --workspace @eiasc/web",
    "test": "npm run test --workspace @eiasc/api",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:import-geography": "tsx scripts/import-geography.ts",
    "db:verify-geography": "tsx scripts/verify-geography.ts",
    "db:bootstrap": "npm run db:deploy && npm run db:seed && npm run db:import-geography && npm run db:verify-geography",
    "test:e2e": "playwright test",
    "security:review": "node scripts/security-review.mjs",
    "ops:smoke": "node scripts/production-smoke.mjs",
    "ops:backup-restore": "bash scripts/backup-restore-drill.sh"
  },
  "dependencies": { "dotenv": "^16.4.7", "xlsx": "0.18.5" },
  "devDependencies": { "@playwright/test": "^1.52.0", "@types/node": "20.17.24", "@types/react": "18.3.18", "@types/react-dom": "18.3.5", "@typescript-eslint/eslint-plugin": "8.26.0", "@typescript-eslint/parser": "8.26.0", "concurrently": "9.1.2", "eslint": "8.57.1", "prisma": "5.22.0", "tsx": "4.19.3", "typescript": "5.8.2" },
  "prisma": { "seed": "tsx prisma/seed.ts" }
}
